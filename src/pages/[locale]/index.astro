---
import PublishedPage from "../../components/PublishedPage.astro";
import { isLocale, locales, pageFor, type Locale } from "../../lib/site";
interface Props {
    locale: Locale;
}
export function getStaticPaths() {
    return locales.map(locale => ({ params: { locale }, props: { locale } }));
}
const { locale } = Astro.props;
if (!isLocale(locale)) {
    throw new Error("Invalid published locale");
}
const page = pageFor(locale);
---
<PublishedPage {locale} slug="" {page}/>
