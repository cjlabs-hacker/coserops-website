---
import PublishedPage from "../../components/PublishedPage.astro";
import { isLocale, locales, publishedRoutes, pageFor, type Locale } from "../../lib/site";
interface Props {
    locale: Locale;
    slug: string;
}
export function getStaticPaths() {
    return locales.flatMap(locale =>
        publishedRoutes[locale].filter(Boolean).map(slug => ({
            params: { locale, slug },
            props: { locale, slug }
        }))
    );
}
const { locale, slug } = Astro.props;
if (!isLocale(locale)) {
    throw new Error("Invalid published locale");
}
const page = pageFor(locale, slug);
---
<PublishedPage {locale} {slug} {page}/>
