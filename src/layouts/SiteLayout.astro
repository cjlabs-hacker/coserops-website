---
import { t, localeInfo } from "../lib/i18n";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { hasRoute, isIndexable, jsonLd, locales, pathFor, site, type Locale } from "../lib/site";
interface Props {
    locale: Locale;
    title: string;
    description: string;
    slug?: string;
    noindex?: boolean;
}
const { locale, title, description, slug = "", noindex = false } = Astro.props;
const canonical = site + pathFor(locale, slug);
const shareImage = `${site}/og-image.png`;
const alternates = noindex ? [] : locales.filter(language => hasRoute(language, slug) && isIndexable(slug));
const defaultLocale = slug === "" ? "zh-cn" : "en";
const defaultUrl = !noindex && hasRoute(defaultLocale, slug) && isIndexable(slug)
    ? site + pathFor(defaultLocale, slug)
    : undefined;
---
<!doctype html>
<html lang={localeInfo[locale].lang}>
    <head>
        <meta charset="UTF-8"/>
        <meta name="viewport" content="width=device-width"/>
        <meta name="description" content={description}/>
        <title>{title}</title>
        <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/>
        <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png"/>
        <link rel="canonical" href={canonical}/>
        {
            alternates.map(language => (
                <link rel="alternate" hreflang={localeInfo[language].lang} href={site + pathFor(language, slug)}/>
            ))
        }
        {
            defaultUrl && (
                <link rel="alternate" hreflang="x-default" href={defaultUrl}/>
            )
        }
        {
            noindex && (
                <meta name="robots" content="noindex,follow"/>
            )
        }
        <meta property="og:type" content="website"/>
        <meta property="og:site_name" content="CoserOps"/>
        <meta property="og:title" content={title}/>
        <meta property="og:description" content={description}/>
        <meta property="og:url" content={canonical}/>
        <meta property="og:image" content={shareImage}/>
        <meta property="og:image:alt" content={t(locale, "layout.imageAlt")}/>
        <meta property="og:image:type" content="image/png"/>
        <meta property="og:image:width" content="1200"/>
        <meta property="og:image:height" content="630"/>
        <meta property="og:locale" content={localeInfo[locale].openGraph}/>
        {
            alternates.filter(language => language !== locale).map(language => (
                <meta property="og:locale:alternate" content={localeInfo[language].openGraph}/>
            ))
        }
        <meta name="twitter:card" content="summary_large_image"/>
        <meta name="twitter:title" content={title}/>
        <meta name="twitter:description" content={description}/>
        <meta name="twitter:image" content={shareImage}/>
        <meta name="twitter:image:alt" content={t(locale, "layout.imageAlt")}/>
        <script
            type="application/ld+json"
            set:html={jsonLd({
                "@context": "https://schema.org",
                "@graph": [
                    {
                        "@type": "Organization",
                        "@id": `${site}/#organization`,
                        name: "CoserOps",
                        description: "CoserOps is the brand name for Coser Operations Center.",
                        url: `${site}/`,
                        logo: {
                            "@type": "ImageObject",
                            url: `${site}/logo.svg`
                        }
                    },
                    {
                        "@type": "WebSite",
                        "@id": `${site}/#website`,
                        url: `${site}/`,
                        name: "CoserOps",
                        inLanguage: locales.map(language => localeInfo[language].lang),
                        publisher: {"@id": `${site}/#organization`}
                    }
                ]
            })}
        />
    </head>
    <body>
        <a class="skip-link" href="#main">{t(locale, "layout.skip")}</a>
        <Header {locale} {slug}/>
        <main id="main" tabindex="-1">
            <slot/>
        </main>
        <Footer {locale}/>
    </body>
</html>
