---
import { t } from "../lib/i18n";
import { labels, pathFor, type Locale } from "../lib/site";
interface Props {
    locale: Locale;
}
const { locale } = Astro.props;
const l = labels(locale);
---
<footer class="site-footer">
    <div class="shell footer-grid">
        <div>
            <a class="brand brand--footer" href={pathFor(locale)}>
                <img class="brand-mark" src="/logo-mark.svg" alt="" width="34" height="34"/>
                <span>CoserOps<small>Coser Operations Center</small></span>
            </a>
            <p>{t(locale, "footer.description")}</p>
        </div>
        <div>
            <p class="footer-title">{t(locale, "footer.explore")}</p>
            <a href={pathFor(locale, "product")}>{l.product}</a>
            <a href={pathFor(locale, "solutions")}>{l.solutions}</a>
            <a href={pathFor(locale, "channels")}>{l.channels}</a>
            <a href={pathFor(locale, "resources")}>{l.resources}</a>
        </div>
        <div>
            <p class="footer-title">{t(locale, "footer.website")}</p>
            <a href={pathFor(locale, "about")}>{l.about}</a>
            <a href={pathFor(locale, "contact")}>{l.contact}</a>
            <a href={pathFor(locale, "privacy")}>{l.privacy}</a>
            <a href={pathFor(locale, "terms")}>{l.terms}</a>
            <a href="https://github.com/cjlabs-hacker/coserops-website">{t(locale, "footer.source")}</a>
        </div>
    </div>
    <div class="shell footer-bottom">© {new Date().getFullYear()}
        CoserOps. {t(locale, "footer.notice")}</div>
</footer>
